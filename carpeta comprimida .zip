#include <iostream>

using namespace std;
int main(){
    int edad;
    cout << "ingresa tu edad: ";
    cin >>edad;
    if (edad >18 ){
        cout << "Eres mayor de edad, puedes ingresar. " <<endl;
        }else {
            cout << " Eres menor de edad, disculpa. " <<endl;
        }
    return 0;
}